# Copy this file to .env on the Ubuntu RADIUS VPS. Never commit the real file.
# These values connect the RADIUS container to the same production Expressnet
# database. Obtain DATABASE_PUBLIC_URL and DJANGO_SECRET_KEY from the platform.
DJANGO_SETTINGS_MODULE=billing_saas_django.Settings.production
DJANGO_SECRET_KEY=
DATABASE_PUBLIC_URL=
DATABASE_SSL_REQUIRE=true
REDIS_URL=

# Bind ports inside the container. The VPS firewall must allow UDP 1812/1813.
RADIUS_HOST=0.0.0.0
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# This is the VPS's public IPv4 or DNS name. Set this same value ONCE in the
# Railway Expressnet service. It is a platform setting, never a tenant setting.
RADIUS_SERVER_IP=

# Copy this file to .env for the same Docker host as Expressnet. Never commit
# the real file. The RadSec service creates its own persistent PKI and derives
# its public hostname from PUBLIC_APP_URL.
DJANGO_SETTINGS_MODULE=billing_saas_django.Settings.production
DJANGO_SECRET_KEY=
DATABASE_PUBLIC_URL=
DATABASE_SSL_REQUIRE=true
REDIS_URL=
# Already set by the Expressnet application deployment; used only as the
# non-Railway fallback for the generated RadSec server certificate name.
PUBLIC_APP_URL=https://expressnetbilling.com

# Optional only when the public RadSec endpoint has a different hostname than
# PUBLIC_APP_URL. The host must map TCP 2083 to the `radius` service.
# RADIUS_RADSEC_HOST=radsec.example.com

# Copy this file to .env on the Ubuntu RADIUS VPS. Never commit the real file.
# These values connect the RADIUS container to the same production Expressnet
# database. Obtain DATABASE_PUBLIC_URL and DJANGO_SECRET_KEY from the platform.
DJANGO_SETTINGS_MODULE=billing_saas_django.Settings.production
DJANGO_SECRET_KEY=
DATABASE_PUBLIC_URL=
DATABASE_SSL_REQUIRE=true
REDIS_URL=

# RadSec gateway. The VPS firewall must allow only TCP 2083 from the internet.
# The embedded Django policy server remains private on 127.0.0.1 UDP 1812/1813.
RADIUS_TRANSPORT=radsec
RADIUS_RADSEC_HOST=
RADIUS_RADSEC_PORT=2083
RADIUS_RADSEC_LISTEN_PORT=2083
RADIUS_RADSEC_TLS_CERT_FILE=/run/secrets/radsec/server.pem
RADIUS_RADSEC_TLS_KEY_FILE=/run/secrets/radsec/server-key.pem
RADIUS_RADSEC_TLS_CA_FILE=/run/secrets/radsec/ca.pem
RADIUS_PROXY_SHARED_SECRET=radsec

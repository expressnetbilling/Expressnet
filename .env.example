DJANGO_SETTINGS_MODULE=billing_saas_django.Settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
USE_DJANGO_TENANTS=false
# Production tenant login domain. Configure wildcard DNS and TLS for *.expressnetbilling.com.
TENANT_BASE_DOMAIN=expressnetbilling.com
# Temporary testing bypass; set true again when production SMTP verification is ready.
TENANT_EMAIL_VERIFICATION_REQUIRED=false
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

API_BASE_PATH=api
ADMIN_API_PATH=admin
ADMIN_FRONTEND_PATH=admin
# Optional exact hostnames allowed to serve the admin API, comma separated.
# Set this in Railway when using its generated domain or a non-admin custom host.
ADMIN_API_ALLOWED_HOSTS=
VITE_API_BASE_URL=/api
VITE_PUBLIC_BASE_DOMAIN=expressnetbilling.com
VITE_TENANT_BASE_DOMAIN=expressnetbilling.com
VITE_APP_SUBDOMAIN=app
VITE_ADMIN_SUBDOMAIN=admin
VITE_ADMIN_PATH=/admin
VITE_ADMIN_API_PATH=/admin
# Optional captive portal host override; production otherwise uses PUBLIC_APP_URL.
CAPTIVE_PORTAL_PUBLIC_URL=

# Platform Daraja collection and tenant settlement.
# Customers pay into this shortcode by STK push; tenant bank settlements use
# Daraja B2B and require a B2B-enabled initiator plus each tenant's recipient.
PUBLIC_APP_URL=https://expressnetbilling.com
DARAJA_CALLBACK_BASE_URL=https://expressnetbilling.com
DARAJA_ENVIRONMENT=production
# Live platform collection credentials. These are used for tenants without
# their own Daraja credentials. Keep the live shortcode and passkey together.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TILL_NUMBER=
DARAJA_SHORTCODE_TYPE=CustomerPayBillOnline
DARAJA_DEFAULT_METHOD=daraja_paybill
# Optional separate sandbox credential set, used only when DARAJA_ENVIRONMENT=sandbox.
DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
DARAJA_SANDBOX_SHORTCODE=
DARAJA_SANDBOX_PASSKEY=
DARAJA_SANDBOX_TILL_NUMBER=
DARAJA_SANDBOX_SHORTCODE_TYPE=CustomerPayBillOnline
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
# Set true only after Paystack has enabled manual payouts for the platform balance.
PAYSTACK_MANUAL_PAYOUTS_ENABLED=false
PAYSTACK_WITHDRAWAL_FEE_KES=80
PAYSTACK_CALLBACK_BASE_URL=https://expressnetbilling.com
# Optional platform share deducted from each tenant's Paystack withdrawal balance, percent (0-100).
PAYSTACK_PLATFORM_FEE_PERCENT=0
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ENVIRONMENT=production
MPESA_SHORTCODE=
MPESA_BUSINESS_SHORTCODE=
MPESA_SHORTCODE_TYPE=CustomerPayBillOnline
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Keep customer verification responsive even when Daraja is degraded. Values
# are seconds and are bounded to 1-30 by the application.
DARAJA_OAUTH_TIMEOUT_SECONDS=10
DARAJA_STK_TIMEOUT_SECONDS=15
DARAJA_VERIFY_TIMEOUT_SECONDS=10
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_SECURITY_CREDENTIAL=
# B2C pays a phone number. It must not use BusinessTransferFromMMFToUtility.
# Bank Paybill settlements use the B2B command below instead.
DARAJA_B2C_COMMAND_ID=BusinessPayment
# B2B settlement needs a shortcode with B2B enabled and an API user assigned
# the corresponding B2B initiator role by Safaricom.
# This is the source shortcode (PartyA). Its available balance and settlement
# permissions are controlled by Safaricom; customer collection funds are not
# moved from utility to working by an API command in this application.
DARAJA_B2B_SHORTCODE=
DARAJA_B2B_INITIATOR_NAME=
DARAJA_B2B_SECURITY_CREDENTIAL=
# Bank destinations are always sent as BusinessPayBill. Buy Goods tills use
# BusinessBuyGoods automatically, so no B2B command override is accepted.
DARAJA_B2B_SENDER_IDENTIFIER_TYPE=4
DARAJA_B2B_RECEIVER_IDENTIFIER_TYPE=4
DARAJA_B2B_TILL_IDENTIFIER_TYPE=2
PLATFORM_FEE_PERCENTAGE=0
PLATFORM_FEE_FIXED=0
# System subscription fee charged to tenants as a percentage of monthly successful internet sales.
# Example: 0.03 means 0.03%, so KES 100,000 in sales produces a KES 30 fee.
SYSTEM_SUBSCRIPTION_FEE_PERCENT=0.03

# Railway deploys can use Railway variable references for the private URL:
# DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
#
# Do not copy a ${{...}} template into local .env; Railway expands that syntax,
# but local dotenv does not. For local access through Railway's public TCP proxy,
# use the actual values from the Postgres service Variables and Settings tabs:
# PGUSER=postgres
# PGPASSWORD=<actual password>
# PGDATABASE=railway
# RAILWAY_TCP_PROXY_DOMAIN=<public proxy host>
# RAILWAY_TCP_PROXY_PORT=<public proxy port, shown in Networking>
# The local settings build and URL-encode the public connection URL from these.
# Alternatively, set DATABASE_PUBLIC_URL to a fully resolved URL with an
# URL-encoded password:
# DATABASE_PUBLIC_URL=postgresql://postgres:<url-encoded-password>@<RAILWAY_TCP_PROXY_DOMAIN>:<RAILWAY_TCP_PROXY_PORT>/railway
DATABASE_URL=
DATABASE_PUBLIC_URL=
DATABASE_SSL_REQUIRE=true
REDIS_URL=redis://localhost:6379/0

# Platform WireGuard tunnel for MikroTik routers.
# Tenants do not configure these; they only paste the generated provisioning command.
# The app auto-fills endpoint/port/tunnel defaults, but the platform server public key
# must be set once by the deployment because routers use it to verify the VPN server.
WG_SERVER_PUBLIC_KEY=
WG_SERVER_ENDPOINT=
WG_SERVER_PORT=51820
WG_SERVER_TUNNEL_IP=10.8.0.1
# Optional fixed router tunnel IP. Leave blank to auto-assign one per tenant/router.
WG_ROUTER_TUNNEL_IP=
# Supported aliases in production: WIREGUARD_SERVER_PUBLIC_KEY,
# WIREGUARD_SERVER_ENDPOINT, WIREGUARD_SERVER_PORT, WIREGUARD_SERVER_TUNNEL_IP.

# Central RADIUS endpoint. Configure these once for the whole platform after
# deploying the `radius` Docker service on a VPS; tenants never configure them.
# MikroTik provisioning creates the client and its unique shared secret itself.
RADIUS_SERVER_IP=
RADIUS_SOURCE_IP=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# RadSec is the production transport when Railway cannot accept public UDP.
# Deploy the `radsec` service on a VPS with a fixed public IPv4 and open TCP
# 2083. RouterOS forces native RadSec to port 2083, so a Railway TCP proxy
# with a dynamically assigned public port cannot be used directly. The signed
# provisioning command issues and imports a per-router client certificate
# automatically. These are platform-admin settings only; tenants enter none
# of them. Do not expose UDP 1812/1813 publicly when using RadSec.
RADIUS_TRANSPORT=radsec
RADIUS_RADSEC_HOST=
RADIUS_RADSEC_PORT=2083
# Base64-encoded private CA used only by the platform to issue per-router
# client bundles during provisioning. Do not expose these values to tenants,
# browsers, or the RadSec VPS. The VPS receives only the CA certificate file.
RADSEC_CA_CERT_PEM_B64=
RADSEC_CA_KEY_PEM_B64=
RADSEC_CA_KEY_PASSWORD=
# Paths inside the RadSec gateway on the VPS. Mount these files read-only; do
# not place the server private key or the CA private key in Railway. The CA
# certificate must validate client certificates issued to MikroTik routers.
RADIUS_RADSEC_TLS_CERT_FILE=/run/secrets/radsec/server.pem
RADIUS_RADSEC_TLS_KEY_FILE=/run/secrets/radsec/server-key.pem
RADIUS_RADSEC_TLS_CA_FILE=/run/secrets/radsec/ca.pem
# Only used between FreeRADIUS and Django on private loopback.
RADIUS_PROXY_SHARED_SECRET=radsec

# MikroTik provisioning defaults. The script creates this bridge and adds LAN
# ethernet ports except the WAN interface.
MIKROTIK_BRIDGE_NAME=billing-bridge
MIKROTIK_WAN_INTERFACE=ether1
MIKROTIK_LAN_CIDR=192.168.88.1/24
MIKROTIK_LAN_NETWORK=192.168.88.0/24
MIKROTIK_DHCP_POOL=192.168.88.10-192.168.88.254
MIKROTIK_HOTSPOT_DNS_NAME=signup.billing.local

# TR-069 CPE management through a GenieACS NBI service.
GENIEACS_NBI_URL=
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=

DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_NAME=Super Admin

# Gmail SMTP for login verification codes. The IPv4 backend avoids production
# SMTP failures when the platform has broken IPv6 routing.
EMAIL_BACKEND=billing_api.email_backend.IPv4EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAILS=
